# ============================================================
#  VIDORA — AI Video Intelligence & Deep Context Engine
# ============================================================

# Google Gemini API Key (get it at https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ChromaDB Remote / Cloud Settings (https://trychroma.com)
CHROMA_HOST=https://api.trychroma.com
CHROMA_PORT=443
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_COLLECTION=vidora

# Backend Server Port
PORT=5000
